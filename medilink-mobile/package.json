{
  "name": "medilink-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "build:android": "eas build --platform android",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "update:preview": "eas update --channel preview",
    "update:prod": "eas update --channel production",
    "build:ios": "eas build --platform ios",
    "build:ios:demo": "eas build --platform ios --profile demo",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:prod": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "babel-preset-expo": "^55.0.13",
    "expo": "^54.0.0",
    "expo-clipboard": "^55.0.9",
    "expo-document-picker": "^55.0.9",
    "expo-image-picker": "^55.0.14",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "firebase": "^12.11.0",
    "react": "^19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "eas-cli": "^16.18.3"
  }
}
