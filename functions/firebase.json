{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "runtime": "nodejs22",
    "gen": 2,
    "cpu": 1,
    "memory": "512MB",
    "region": "us-central1",
    "params": {
      "gemini_key": "AIzaSyCl7dqFMm8c0qGVdkm50hifhtvPGSh5PC",
      "whatsapp_phone_id": "YOUR_PHONE_ID",
      "whatsapp_token": "YOUR_WHATSAPP_TOKEN"
    },
    "source": "functions"
  },
  "hosting": {
    "public": "webapp/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
